# ── API Base URL Configuration ─────────────────────────────────────
# For Localhost (Vite dev proxy forwards /api to backend automatically):
# VITE_API_URL=/api
#
# For direct Localhost backend connection:
# VITE_API_URL=http://localhost:5000/api
#
# For Aletcloud / Fullstack Docker deployment (served together on same host):
# VITE_API_URL=/api
#
# For separated deployment (e.g. Vercel frontend -> Aletcloud backend):
# VITE_API_URL=https://your-app.aletcloud.com/api
VITE_API_URL=/api

# Optional: Set backend proxy target in Vite dev mode (defaults to http://localhost:5000)
# To point your local frontend to remote Aletcloud backend during development:
# VITE_BACKEND_URL=https://your-app.aletcloud.com
VITE_BACKEND_URL=http://localhost:5000
