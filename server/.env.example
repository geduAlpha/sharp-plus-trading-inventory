PORT=5000
MONGO_URI=mongodb+srv://<db_username>:<db_password>@cluster0.dihvcpk.mongodb.net/sharp_plus_db?retryWrites=true&w=majority&appName=Cluster0
JWT_SECRET=change_this_to_a_long_random_secret_minimum_32_chars
JWT_EXPIRES_IN=7d
NODE_ENV=production

# ── Allowed Client Origins (CORS) ─────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# localhost, 127.0.0.1, *.aletcloud.com, *.onrender.com are auto-allowed.
# Add your custom domain here if different from PUBLIC_URL:
CLIENT_URL=https://your-app-name.aletcloud.com

# ── Live Deployment Public URL ─────────────────────────────────────────
# Set to your Aletcloud app URL. Enables:
#   1. Keep-alive self-pings every 10 min (prevents cold starts)
#   2. Auto-adds to CORS allowed origins
PUBLIC_URL=https://your-app-name.aletcloud.com

# ── OCR API (Image POS Report Scanning) ───────────────────────────────
# Free key: 'helloworld' (limited). Get your own at https://ocr.space/ocrapi
OCR_API_KEY=helloworld

# ── Google Gemini AI Assistant ─────────────────────────────────────────
# Get a FREE key at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Telegram Bot Notifications (Optional) ─────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
